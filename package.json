{
  "name": "url-shortener",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev:frontend": "pnpm --filter @url-shortener/frontend dev",
    "dev:backend": "pnpm --filter @url-shortener/backend dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.61.0"
  }
}
